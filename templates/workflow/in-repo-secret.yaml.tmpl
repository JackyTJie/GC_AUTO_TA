# 触发 JOJ3 评测 + 把 score-<sha7>.json push 回仓库（私有组织 / 私有仓库）
#
# 生成者：GC_AUTO_TA（模板 in-repo-secret）
# 需要：组织级 secret {{secret_name}}（PAT：read:repository + write:repository，owner 为该 PAT 的账号）
# 要点：
#   * 容器内一律用 {{gitea_internal}}，绝不用公网域名（公网 http 跳 https 会把 URL 里的凭据丢掉）
#   * job 镜像没有 curl，统一用 python3 处理 HTTP 与字符串
#   * 分数文件名必须与 config.yaml 的 grading.score_file_pattern 一致（默认 score-{sha7}.json）
name: joj3

on: [push, workflow_dispatch]

jobs:
  grade:
    runs-on: {{job_label}}
    env:
      GC_BASE: "{{gitea_internal}}/{{org}}/{{repo}}.git"
      GC_OWNER: "{{owner}}"
      GC_TOKEN: ${{ secrets.{{secret_name}} }}
      GC_SCORE_FILE: "score-REPLACED_BY_SHA.json"
    steps:
      - name: get code
        run: |
          git clone -q "$(python3 -c "import os;print(os.environ['GC_BASE'].replace('://','://%s:%s@'%(os.environ['GC_OWNER'],os.environ['GC_TOKEN'])))")" repo

      - name: grade
        working-directory: repo
        run: joj3 -conf-root {{conf_root}} -conf-name {{conf_name}}

      - name: show result
        working-directory: repo
        run: |
          echo "===== joj3_result.json ====="
          cat joj3_result.json

      - name: publish score
        working-directory: repo
        run: |
          set -e
          SCORE_FILE="score-${GITHUB_SHA:0:7}.json"
          cp joj3_result.json "$SCORE_FILE"
          git config user.email bot@local
          git config user.name bot
          git add "$SCORE_FILE"
          git commit -q -m "chore: score ${GITHUB_SHA:0:7} [skip ci]"
          git push -q "$(python3 -c "import os;print(os.environ['GC_BASE'].replace('://','://%s:%s@'%(os.environ['GC_OWNER'],os.environ['GC_TOKEN'])))")" "HEAD:${GITHUB_REF_NAME}"

# 触发 JOJ3 评测 + 把结果开成 issue（私有组织 / 私有仓库：带 token clone）
#
# 生成者：GC_AUTO_TA（模板 in-repo-secret-issue）
# 需要：组织级 secret {{secret_name}}（PAT：read:repository + write:issue，owner 为该 PAT 的账号）
# 要点：
#   * 私有组织下匿名 clone 必 401（容器无终端，git 卡在 "could not read Username"），必须带凭据
#   * 容器内一律用 {{gitea_internal}}，绝不用公网域名（公网 http 跳 https 会把 URL 里的凭据丢掉）
#   * 凭据在容器内用 python3 拼装，owner 必须是 token 主人，不是学生
#   * job 镜像没有 curl，HTTP 统一用 python3
name: joj3

on: [push, workflow_dispatch]

jobs:
  grade:
    runs-on: {{job_label}}
    env:
      GC_BASE: "{{gitea_internal}}/{{org}}/{{repo}}.git"
      GC_OWNER: "{{owner}}"
      GC_TOKEN: ${{ secrets.{{secret_name}} }}
    steps:
      - name: get code
        run: |
          git clone -q "$(python3 -c "import os;print(os.environ['GC_BASE'].replace('://','://%s:%s@'%(os.environ['GC_OWNER'],os.environ['GC_TOKEN'])))")" repo

      - name: grade
        working-directory: repo
        run: joj3 -conf-root {{conf_root}} -conf-name {{conf_name}}

      - name: show result
        working-directory: repo
        run: |
          echo "===== joj3_result.json ====="
          cat joj3_result.json

      - name: report as issue
        working-directory: repo
        run: |
          python3 - <<'PY'
          import json, os, urllib.request
          result = json.load(open("joj3_result.json"))
          payload = json.dumps({
              "title": "Grading result " + os.environ.get("GITHUB_SHA", "")[:7],
              "body": "commit `%s`\n\n```json\n%s\n```" % (
                  os.environ.get("GITHUB_SHA", ""),
                  json.dumps(result, ensure_ascii=False, indent=2)),
          }).encode()
          req = urllib.request.Request(
              "{{gitea_internal}}/api/v1/repos/%s/issues" % os.environ["GITHUB_REPOSITORY"],
              data=payload,
              headers={"Content-Type": "application/json",
                       "Authorization": "token " + os.environ["GC_TOKEN"]})
          print("issue:", urllib.request.urlopen(req).status)
          PY

# 触发 JOJ3 评测：评分文件来自 TA 私有仓库 + 分数 push 回学生仓库（scheme C + 回传）
#
# 生成者：GC_AUTO_TA（模板 config-repo-secret）
# 需要：组织级 secret {{secret_name}}（PAT：read:repository + write:repository）
name: joj3

on: [push, workflow_dispatch]

jobs:
  grade:
    runs-on: {{job_label}}
    env:
      GC_BASE: "{{gitea_internal}}/{{org}}/{{repo}}.git"
      GC_CFG: "{{gitea_internal}}/{{org}}/{{config_repo}}.git"
      GC_OWNER: "{{owner}}"
      GC_TOKEN: ${{ secrets.{{secret_name}} }}
    steps:
      - name: get code and grading config
        run: |
          set -e
          AUTH() { python3 -c "import os,sys;print(sys.argv[1].replace('://','://%s:%s@'%(os.environ['GC_OWNER'],os.environ['GC_TOKEN'])))" "$1"; }
          git clone -q "$(AUTH "$GC_BASE")" repo
          git clone -q "$(AUTH "$GC_CFG")" cfg

      - name: grade
        working-directory: repo
        run: joj3 -conf-root ../cfg/{{conf_root}} -conf-name {{conf_name}}

      - name: show result
        working-directory: repo
        run: cat joj3_result.json

      - name: publish score
        working-directory: repo
        run: |
          set -e
          SCORE_FILE="score-${GITHUB_SHA:0:7}.json"
          cp joj3_result.json "$SCORE_FILE"
          git config user.email bot@local
          git config user.name bot
          git add "$SCORE_FILE"
          git commit -q -m "chore: score ${GITHUB_SHA:0:7} [skip ci]"
          git push -q "$(python3 -c "import os;print(os.environ['GC_BASE'].replace('://','://%s:%s@'%(os.environ['GC_OWNER'],os.environ['GC_TOKEN'])))")" "HEAD:${GITHUB_REF_NAME}"

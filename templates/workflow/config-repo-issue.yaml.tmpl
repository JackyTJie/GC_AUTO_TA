# 触发 JOJ3 评测：评分文件来自 TA 私有仓库 + 结果开 issue（scheme C + issue 回传）
#
# 生成者：GC_AUTO_TA（模板 config-repo-issue）
# 需要：组织级 secret {{secret_name}}（PAT：read:repository + write:issue）
name: joj3

on: [push, workflow_dispatch]

jobs:
  grade:
    runs-on: {{job_label}}
    env:
      GC_BASE: "{{gitea_internal}}/{{org}}/{{repo}}.git"
      GC_CFG: "{{gitea_internal}}/{{org}}/{{config_repo}}.git"
      GC_OWNER: "{{owner}}"
      GC_TOKEN: ${{ secrets.{{secret_name}} }}
    steps:
      - name: get code and grading config
        run: |
          set -e
          AUTH() { python3 -c "import os,sys;print(sys.argv[1].replace('://','://%s:%s@'%(os.environ['GC_OWNER'],os.environ['GC_TOKEN'])))" "$1"; }
          git clone -q "$(AUTH "$GC_BASE")" repo
          git clone -q "$(AUTH "$GC_CFG")" cfg

      - name: grade
        working-directory: repo
        run: joj3 -conf-root ../cfg/{{conf_root}} -conf-name {{conf_name}}

      - name: show result
        working-directory: repo
        run: cat joj3_result.json

      - name: report as issue
        working-directory: repo
        run: |
          python3 - <<'PY'
          import json, os, urllib.request
          result = json.load(open("joj3_result.json"))
          payload = json.dumps({
              "title": "Grading result " + os.environ.get("GITHUB_SHA", "")[:7],
              "body": "commit `%s`\n\n```json\n%s\n```" % (
                  os.environ.get("GITHUB_SHA", ""),
                  json.dumps(result, ensure_ascii=False, indent=2)),
          }).encode()
          req = urllib.request.Request(
              "{{gitea_internal}}/api/v1/repos/%s/issues" % os.environ["GITHUB_REPOSITORY"],
              data=payload,
              headers={"Content-Type": "application/json",
                       "Authorization": "token " + os.environ["GC_TOKEN"]})
          print("issue:", urllib.request.urlopen(req).status)
          PY
